@startuml
title Diagrama de secuencia UML: iniciar sesión (HU-09) y consultar disponibilidad (HU-01)
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #1F3864
skinparam NodeBorderColor #1F3864
skinparam NodeBackgroundColor #F2F2F2
skinparam ArtifactBorderColor #1F3864
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #BF9000
skinparam SequenceLifeLineBorderColor #1F3864
skinparam ParticipantBorderColor #1F3864
skinparam ParticipantBackgroundColor #F2F2F2
autonumber
actor "Estudiante / Docente" as U
participant "Interfaz Web" as W
participant "SesionRest" as SC
participant "UsuarioService" as US
participant "SesionService" as SS
participant "RecursosRest" as RC
participant "RecursoService" as RS
participant "DisponibilidadService" as D

U -> W : correo y contraseña
W -> SC : POST /api/sesion
SC -> US : autenticar(correo, contrasena)
alt campos vacíos (HU-09 Esc. 3)
  US --> W : 400 «Faltan campos obligatorios: …»
else usuario o contraseña incorrectos (HU-09 Esc. 2)
  US --> W : 401 «Usuario o contraseña incorrectos»
else credenciales correctas (HU-09 Esc. 1)
  US -> US : Contrasenas.coincide(clave, resumen PBKDF2)
  US --> SC : Usuario
  SC -> SS : abrir(usuario)
  SS --> W : 200 token + usuario (rol)
end
U -> W : fecha, hora de inicio y fin
W -> RC : GET /api/recursos/disponibles?… (Bearer token)
RC -> RS : consultarDisponibles(fecha, inicio, fin)
alt falta fecha u hora, o fin ≤ inicio
  RS --> W : 400 campos faltantes / horario no válido
else consulta válida
  RS -> D : recursosOcupados(fecha, inicio, fin)
  D --> RS : conjunto de ids de recursos ocupados (una sola pasada)
  RS --> W : 200 lista de recursos libres (vacía → «No hay recursos disponibles», Esc. 2)
end
@enduml
