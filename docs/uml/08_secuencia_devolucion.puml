@startuml
title Diagrama de secuencia UML: registrar la devolución de un recurso (HU-08)
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #1F3864
skinparam NodeBorderColor #1F3864
skinparam NodeBackgroundColor #F2F2F2
skinparam ArtifactBorderColor #1F3864
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #BF9000
skinparam SequenceLifeLineBorderColor #1F3864
skinparam ParticipantBorderColor #1F3864
skinparam ParticipantBackgroundColor #F2F2F2
autonumber
actor "Usuario" as U
participant "Interfaz Web" as W
participant "PrestamosRest\n(@RestController)" as C
participant "PrestamosTransaccionales\n(transacción PostgreSQL)" as T
participant "PrestamoServiceProxy" as P
participant "UsuarioService\n(AutorizacionPort)" as A
participant "PrestamoService" as S
participant "Prestamo" as PR
participant "Recurso" as R

U -> W : pulsa «Registrar devolución»
W -> C : POST /api/prestamos/{id}/devolver
C -> T : registrarDevolucion(actor, id)
T -> T : BEGIN · pg_advisory_xact_lock
T -> P : registrarDevolucion(actor, id)
P -> A : tienePermiso(actor, REGISTRAR_DEVOLUCION)
alt estudiante o docente (HU-08 Esc. 3, RN-02)
  A --> P : false
  P --> W : 403 «Su rol no tiene permiso para esta acción»
else encargado
  A --> P : true
  P -> S : registrarDevolucion(actor, id)
  S -> PR : finalizar(ahora)
  alt el préstamo ya estaba Finalizado (HU-08 Esc. 2)
    PR --> W : 409 «El recurso ya fue devuelto»
  else estaba Activo
    PR -> PR : estado = Finalizado · fechaDevolucion = ahora
    alt no quedan otros préstamos activos del recurso
      S -> R : marcarDisponible()
    end
    S --> W : 200 préstamo «Finalizado» (HU-08 Esc. 1)
    T -> T : COMMIT (el disparador de la base marca la solicitud como devuelta)
  end
end
@enduml
