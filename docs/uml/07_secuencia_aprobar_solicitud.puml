@startuml
title Diagrama de secuencia UML: aprobar una solicitud (HU-07, HU-04 y creación del préstamo)
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #1F3864
skinparam NodeBorderColor #1F3864
skinparam NodeBackgroundColor #F2F2F2
skinparam ArtifactBorderColor #1F3864
skinparam NoteBackgroundColor #FFF9DB
skinparam NoteBorderColor #BF9000
skinparam SequenceLifeLineBorderColor #1F3864
skinparam ParticipantBorderColor #1F3864
skinparam ParticipantBackgroundColor #F2F2F2
autonumber
actor "Encargado" as U
participant "Interfaz Web" as W
participant "SolicitudesRest\n(@RestController)" as C
participant "SolicitudesTransaccionales\n(transacción PostgreSQL)" as T
participant "SolicitudServiceProxy" as P
participant "UsuarioService\n(AutorizacionPort)" as A
participant "SolicitudService" as S
participant "Cadena de aprobación\n(Horario → Conflicto Recurso → Usuario)" as V
participant "Solicitud\n(State)" as SO
participant "NotificadorSolicitante\n(Observer)" as N
participant "NotificacionService" as NS
participant "CreadorDePrestamo\n(Observer)" as CP
participant "PrestamoService" as PS

U -> W : pulsa «Aprobar»
W -> C : POST /api/solicitudes/{id}/aprobar
C -> T : aprobarSolicitud(actor, id)
T -> T : BEGIN · pg_advisory_xact_lock (RNF-05)
T -> P : aprobarSolicitud(actor, id)
P -> A : tienePermiso(actor, DECIDIR_SOLICITUD)
alt el rol no es encargado (RN-02)
  A --> P : false
  P --> W : 403 «Su rol no tiene permiso para esta acción»
else rol con permiso
  A --> P : true
  P -> S : aprobarSolicitud(actor, id)
  S -> S : buscar(id)
  S -> V : validar(solicitud)  [solo si está Pendiente]
  alt el horario de la solicitud ya pasó
    V --> W : 400 «El horario no es válido …»  (sigue Pendiente; el encargado puede rechazarla)
  else se cruza con una reserva aprobada o préstamo sin devolver (HU-07 Esc. 3)
    V --> W : 409 «El recurso ya está reservado …»  (sigue Pendiente)
  else sin conflicto
    V --> S : ok
    S -> SO : aprobar()
    alt ya estaba Aprobada o Rechazada (State)
      SO --> W : 409 TransicionInvalidaException
    else estaba Pendiente
      SO -> SO : cambiarEstado(EstadoAprobada)
      S -> S : guardar(solicitud)
      S -> N : solicitudDecidida(solicitud)
      N -> NS : notificar(solicitanteId, «… fue APROBADA»)
      S -> CP : solicitudDecidida(solicitud)
      CP -> PS : crearPrestamo(solicitud)
      PS -> PS : nuevo Prestamo «Activo» · recurso.marcarPrestado() (misma transacción)
      S --> W : 200 solicitud «Aprobada» (HU-07 Esc. 1)
    end
  end
  T -> T : COMMIT (ROLLBACK si hubo error)
end
@enduml
